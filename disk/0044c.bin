SRCS=	intro.me
DEVICE=	dp
TROFF=	ditroff -P${DEVICE}

paper:	intro.${DEVICE}
	lpr -P${DEVICE} -n intro.${DEVICE}

intro.${DEVICE}: ${SRCS}
	${TROFF} -me -t ${SRCS} > intro.${DEVICE}

clean:
	rm -f intro.${DEVICE} *.spell errs Errs make.out

spell:	${SRCS}
	@for i in ${SRCS}; do \
		echo $$i; spell $$i | sort | comm -23 - spell.ok > $$i.spell; \
	done
