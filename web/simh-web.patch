+
+
+#elif defined (__EMSCRIPTEN__)
+
+/* Browser routines
+
+   Ports "term0" through "term7" are extra terminal panels on the page (see
+   web/src/vaxhost.js).  They behave like hard-wired terminals: always
+   present, carrier always up.  Checked before __unix__, which Emscripten
+   also defines.
+*/
+
+#include <emscripten.h>
+
+#define SIM_WEB_TERMS 8
+
+EM_JS (int, sim_web_serial_read, (int line, char *buf, int count), {
+    return Module.simHost.serialRead (line, HEAPU8.subarray (buf, buf + count));
+    });
+EM_JS (void, sim_web_serial_write, (int line, char *buf, int count), {
+    Module.simHost.serialWrite (line, HEAPU8.slice (buf, buf + count));
+    });
+
+#define WEB_LINE(port) ((int)(intptr_t)(port) - 1)
+
+static int sim_serial_os_devices (int max, SERIAL_LIST* list)
+{
+int i;
+
+for (i = 0; (i < SIM_WEB_TERMS) && (i < max); i++) {
+    sprintf (list[i].name, "term%d", i);
+    sprintf (list[i].desc, "Browser terminal %d", i);
+    }
+return i;
+}
+
+static SERHANDLE sim_open_os_serial (char *name)
+{
+int line;
+
+if ((strncmp (name, "term", 4) != 0) || !isdigit (name[4]) || name[5])
+    return INVALID_HANDLE;
+line = name[4] - '0';
+if (line >= SIM_WEB_TERMS)
+    return INVALID_HANDLE;
+return (SERHANDLE)(intptr_t)(line + 1);
+}
+
+static t_stat sim_config_os_serial (SERHANDLE port, SERCONFIG config)
+{
+return SCPE_OK;
+}
+
+t_stat sim_control_serial (SERHANDLE port, int32 bits_to_set, int32 bits_to_clear, int32 *incoming_bits)
+{
+if (incoming_bits)
+    *incoming_bits = TMXR_MDM_DCD | TMXR_MDM_CTS | TMXR_MDM_DSR;
+return SCPE_OK;
+}
+
+int32 sim_read_serial (SERHANDLE port, char *buffer, int32 count, char *brk)
+{
+int32 n = sim_web_serial_read (WEB_LINE (port), buffer, count);
+
+memset (brk, 0, n);
+return n;
+}
+
+int32 sim_write_serial (SERHANDLE port, char *buffer, int32 count)
+{
+sim_web_serial_write (WEB_LINE (port), buffer, count);
+return count;
+}
+
+static void sim_close_os_serial (SERHANDLE port)
+{
 }
 
 
