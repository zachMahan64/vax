+#elif defined (__EMSCRIPTEN__)
+
+/* Browser routines
+
+   The console is a character queue owned by the JavaScript host (see
+   web/src/worker.js).  Polling the keyboard is also where the simulator
+   yields to the browser event loop, so that keystrokes and screen updates
+   get delivered while the CPU is busy.
+*/
+
+#include <emscripten.h>
+
+EM_JS (int, sim_web_getchar, (void), { return Module.simHost.getchar (); });
+EM_JS (void, sim_web_putchar, (int c), { Module.simHost.putchar (c); });
+EM_ASYNC_JS (void, sim_web_yield, (void), { await Module.simHost.yield (); });
+EM_ASYNC_JS (void, sim_web_readline, (char *buf, int size), {
+    const line = await Module.simHost.readline ();
+    const n = Math.min (line.length, size - 1);
+    for (let i = 0; i < n; i++)
+        HEAPU8[buf + i] = line.charCodeAt (i) & 0xFF;
+    HEAPU8[buf + n] = 0;
+    });
+
+#define SIM_WEB_YIELD_MS 10
+
+/* sim> command lines come from the browser.  stdin there is always at EOF,
+   and SCP ignores EOF on a tty, so reading it would spin forever. */
+
+static char *sim_web_read (char *ptr, int32 size, FILE *stream)
+{
+fflush (stdout);
+sim_web_readline (ptr, size);
+return ptr;
+}
+
+static t_stat sim_os_ttinit (void)
+{
+sim_vm_read = &sim_web_read;
 return SCPE_OK;
 }
 
+static t_stat sim_os_ttrun (void)
+{
+return SCPE_OK;
+}
+
+static t_stat sim_os_ttcmd (void)
+{
+return SCPE_OK;
+}
+
+static t_stat sim_os_ttclose (void)
+{
+return SCPE_OK;
+}
+
+static t_bool sim_os_fd_isatty (int fd)
+{
+return (fd <= 2);
+}
+
+static t_stat sim_os_poll_kbd (void)
+{
+static uint32 last_yield = 0;
+uint32 now = sim_os_msec ();
+int c;
+
+if ((now - last_yield) >= SIM_WEB_YIELD_MS) {
+    last_yield = now;
+    sim_web_yield ();
+    }
+c = sim_web_getchar ();
+if (c < 0)
+    return SCPE_OK;
+if (sim_brk_char && (c == sim_brk_char))
+    return SCPE_BREAK;
+if (sim_int_char && (c == sim_int_char))
+    return SCPE_STOP;
+return (c | SCPE_KFLAG);
+}
+
+static t_bool sim_os_poll_kbd_ready (int ms_timeout)
+{
+sim_os_ms_sleep (ms_timeout);
+return FALSE;
+}
+
+static t_stat sim_os_putchar (int32 out)
+{
+sim_web_putchar (out & 0xFF);
+return SCPE_OK;
+}
+
